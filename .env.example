# =============================================================================
# jira-tempo-mcp — environment configuration template
# =============================================================================
# This is a TEMPLATE. Copy it to `.env` and fill in real values:
#   cp .env.example .env
# This file documents ALL environment variables the MCP server reads.
# Never commit `.env` — it is gitignored and holds secrets.
# =============================================================================

# --- Required (must be filled) ---

# Base URL of your Jira instance (no trailing slash).
JIRA_BASE_URL=https://jira.example.com

# Jira username (login) — used for filtering worklogs by author and logging.
JIRA_USER=your-username

# Personal Access Token (PAT) — create in Jira: Profile → Personal Access Tokens.
# Authenticates both Jira REST API and Tempo 4 API (unless TEMPO_API_TOKEN set).
JIRA_PAT=your_personal_access_token_here

# --- Optional (defaults shown) ---

# Timezone for date/time handling in reports (IANA name).
# JIRA_TIMEZONE=Europe/Moscow

# Separate Tempo API token. Leave empty to reuse JIRA_PAT for Tempo.
# TEMPO_API_TOKEN=

# Log level: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO

# --- Report configuration (optional) ---

# Base directory for weekly reports.
# Default: ~/.mcp/jira-tempo-mcp/reports
# REPORT_OUTPUT_DIR=

# Default team members for team/tasks reports. JSON array of Jira usernames.
# When users param is omitted, this list is used; falls back to [JIRA_USER] if empty.
# REPORT_TEAM_USERS=["pikalov", "tarasenk", "dmz", "gritsel"]

# Display name in report header. Default: JIRA_USER.
# REPORT_AUTHOR_NAME=

# Prefix for report filenames. Default: JIRA_USER.
# REPORT_FILENAME_PREFIX=

# --- Advanced / rarely needed (defaults shown) ---

# HTTP timeout for Jira/Tempo API calls (seconds).
# JIRA_HTTP_TIMEOUT=30.0

# Team report rate-limiting.
# TEMPO_MAX_CONCURRENT_REQUESTS=3   # semaphore limit for concurrent Tempo requests
# TEMPO_REQUEST_DELAY_MS=100       # delay (ms) between request batches
# TEMPO_MAX_RETRIES=3               # retries on HTTP 429 (exponential backoff)

# Output dir for team reports (empty = use REPORT_OUTPUT_DIR).
# REPORT_TEAM_OUTPUT_DIR=

# Custom report templates.
# REPORT_TEMPLATE=default                       # template name for generate_weekly_report
# REPORT_TEMPLATE_PATH=                          # explicit template file path (overrides REPORT_TEMPLATE)
# REPORT_TEMPLATE_DIR=                           # directory scanned for custom templates (.j2 / .py)
# REPORT_TEMPLATE_ALLOW_PY=0                     # opt-in to load .py templates (code execution risk)

# Section mapping (advanced — rarely needed).
# REPORT_SECTION_MAP={"PROJECT-100":"Section A"}  # JSON dict: issue key -> section title
# REPORT_SECTION_MAP_FILE=/path/to/sections.json  # or path to JSON file with the mapping
# REPORT_STABLE_ORDER=["PROJECT-100", "PROJECT-101"]  # issue keys that always appear in this order
# REPORT_NON_ISSUE_SECTIONS=["Team meetings", "Jira triage"]  # sections without issue keys
