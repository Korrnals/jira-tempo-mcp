# Jira + Tempo MCP Server — environment configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` — it is gitignored.

# --- Jira (self-hosted Server / Data Center) ---

# Base URL of your Jira instance (no trailing slash).
JIRA_BASE_URL=https://jira.example.com

# Jira username (login) — used for filtering worklogs by author and logging.
JIRA_USER=your-username

# Personal Access Token (PAT) — create in Jira: Profile → Personal Access Tokens.
# This single token authenticates both Jira REST API and Tempo 4 API.
JIRA_PAT=your_personal_access_token_here

# Timezone for date/time handling in reports (IANA timezone name).
JIRA_TIMEZONE=Europe/Moscow

# --- Optional: separate Tempo API token (only if Tempo API token is configured) ---
# Leave empty to use JIRA_PAT for Tempo as well.
TEMPO_API_TOKEN=

# --- MCP server runtime ---
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Report configuration (optional) ---
# Base directory for weekly reports. Empty = ./reports
# REPORT_OUTPUT_DIR=./reports

# Author display name in report header. Empty = use JIRA_USER.
# REPORT_AUTHOR_NAME=Your Name

# HTTP timeout for Jira/Tempo API calls (seconds, default 30.0).
# JIRA_HTTP_TIMEOUT=30.0

# Custom section mapping for reports (JSON dict, overrides defaults).
# REPORT_SECTION_MAP={"PROJECT-100":"Section A","PROJECT-101":"Section B"}

# Or path to a JSON file with the section mapping.
# REPORT_SECTION_MAP_FILE=/path/to/sections.json

# Prefix for weekly report filenames. Empty = use JIRA_USER.
# REPORT_FILENAME_PREFIX=your-username

# Stable sections — JSON list of issue keys that always appear in this order.
# REPORT_STABLE_ORDER=["PROJECT-100", "PROJECT-101"]

# Non-issue sections — JSON list of section titles without issue keys.
# REPORT_NON_ISSUE_SECTIONS=["Team meetings", "Jira triage"]